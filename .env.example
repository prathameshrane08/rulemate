# Copy to .env and fill in. Never commit .env.

# LLM provider(s) in order of preference; the next one is tried if one fails or times out.
# groq | openai | ollama, e.g. "groq,ollama"
LLM_PROVIDER=groq,ollama
LLM_TIMEOUT=25
LLM_REASONING_EFFORT=low
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (aistudio.google.com -> Get API key). OPTIONAL and kept apart from the bot: only for reading
# drawings and pictures (python -m rulemate design ... --gemini). The bot answers with Groq / Ollama.
GEMINI_API_KEY=
# Optional. Free keys allow about 20 requests per model per day, so RuleMate moves to the next model when one is
# used up; by default it rotates over nine free flash models (rulemate/llm.py, GEMINI_FREE_MODELS).
# One name = try it first; a comma-separated list = use exactly those, in order.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_VISION_MODEL=gemini-3.5-flash

# Any OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Offline
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Paths (defaults shown)
RULES_DIR=data/rules
INDEX_DIR=data/index
EMBED_MODEL=BAAI/bge-small-en-v1.5
